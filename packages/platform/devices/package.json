{
  "name": "@kontave/devices",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "default": "./dist/contracts/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./src/adapters/node/index.ts",
      "default": "./dist/adapters/node/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "imports": {
    "#devices/node/barcode-parser": {
      "types": "./src/adapters/node/barcode-parser.ts",
      "default": "./dist/adapters/node/barcode-parser.js"
    },
    "#devices/node/qw2100-adapter": {
      "types": "./src/adapters/node/qw2100-adapter.ts",
      "default": "./dist/adapters/node/qw2100-adapter.js"
    },
    "#devices/node/serial-port-provider": {
      "types": "./src/adapters/node/serial-port-provider.ts",
      "default": "./dist/adapters/node/serial-port-provider.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "tsx --test test/**/*.test.ts"
  },
  "files": ["dist"],
  "peerDependencies": {
    "serialport": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "serialport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "serialport": "^13.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
