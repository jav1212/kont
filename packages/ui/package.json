{
  "name": "@kontave/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dom/src/index.ts",
    "./dom/src/styles.css"
  ],
  "exports": {
    ".": {
      "kontave-react-native": "./react-native/src/index.tsx",
      "react-native": "./react-native/src/index.tsx",
      "default": "./dom/src/index.ts"
    },
    "./contracts": "./core/src/contracts/index.ts",
    "./tokens": "./core/src/tokens/index.ts"
  },
  "scripts": {
    "check": "pnpm run check:core && pnpm run check:dom && pnpm run check:native",
    "check:core": "tsc --noEmit -p core/tsconfig.json",
    "check:dom": "tsc --noEmit -p dom/tsconfig.json",
    "check:native": "tsc --noEmit -p react-native/tsconfig.json",
    "test": "pnpm run test:core && pnpm run test:native",
    "test:core": "tsx --test core/test/**/*.test.ts",
    "test:native": "jest --config jest.native.config.cjs --runInBand"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "react": "^19.0.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.81.0",
    "@internationalized/date": "^3.11.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@internationalized/date": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "8.4.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.0",
    "react": "19.1.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "@internationalized/date": "^3.11.0",
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "0.81.5",
    "prettier": "^3.6.2"
  }
}
