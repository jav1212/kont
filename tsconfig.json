{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@kontave/payables": ["./packages/business/payables/src/index.ts"],
      "@kontave/payables/domain": ["./packages/business/payables/src/domain/index.ts"],
      "@kontave/payables/application": ["./packages/business/payables/src/application/index.ts"],
      "@kontave/payables/supabase": ["./packages/business/payables/src/adapters/supabase/index.ts"],
      "@kontave/accounting": ["./packages/business/accounting/src/index.ts"],
      "@kontave/accounting/domain": ["./packages/business/accounting/src/domain/index.ts"],
      "@kontave/accounting/application": ["./packages/business/accounting/src/application/index.ts"],
      "@kontave/accounting/supabase": ["./packages/business/accounting/src/adapters/supabase/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.ts",
    "hero.ts",
    "instrumentation.ts",
    "middleware.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
