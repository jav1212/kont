{
  "name": "kont",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "mobile:dev": "corepack pnpm --filter @kontave/mobile dev",
    "mobile:android": "corepack pnpm --filter @kontave/mobile android",
    "mobile:ios": "corepack pnpm --filter @kontave/mobile ios",
    "mobile:web": "corepack pnpm --filter @kontave/mobile web",
    "build": "next build --webpack",
    "start": "next start",
    "check:architecture": "corepack pnpm --filter \"@kontave/*\" run check",
    "test:architecture": "corepack pnpm --filter \"@kontave/*\" run test",
    "lint": "eslint && node scripts/audit-routes.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:shared": "node scripts/audit-shared-schema.mjs",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-supabase.ps1",
    "db:types": "npx -y supabase@latest gen types typescript --project-id fvantswxhepvkloygcvc --schema public > types/database.ts",
    "test:barcode": "node --conditions=react-server --import tsx --test test/barcode-*.test.ts test/code128-badge.test.ts src/modules/auth/backend/barcode/*.test.ts src/modules/auth/backend/barcode/application/*.test.ts src/shared/backend/barcode/*.test.ts apps/device-bridge/test/access-capture.test.ts apps/device-bridge/test/protocol.test.ts",
    "test:barcode:workspace": "node --experimental-test-module-mocks --import tsx --test test/auth-barcode-route.test.ts src/modules/auth/backend/barcode/application/barcode-workspace-policy.test.ts",
    "test:barcode:sql": "node scripts/test-barcode-access-sql.mjs",
    "test:iva:taxation:sql": "node scripts/test-iva-taxation-configuration-sql.mjs",
    "test:iva:reporting:sql": "node scripts/test-iva-reporting-sql.mjs",
    "test:iva:supplier-match:sql": "node scripts/test-iva-supplier-match-sql.mjs",
    "test:company:monetary-policy:sql": "node scripts/test-company-monetary-policy-sql.mjs",
    "test:company:monetary-policy:web": "node --experimental-test-module-mocks --import tsx --test test/company-monetary-policy-route.test.ts",
    "test:fiscal:persistence:sql": "node scripts/test-fiscal-persistence-sql.mjs",
    "test:barcode:web": "node scripts/test-barcode-web.mjs"
  },
