{
  "name": "@kontave/desktop",
  "version": "0.1.0",
  "description": "Aplicación nativa de escritorio de la plataforma Kontave",
  "author": "Kontave",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:shared": "corepack pnpm --filter @kontave/device-contracts build && corepack pnpm --filter @kontave/devices-core build && corepack pnpm --filter @kontave/devices-node build && corepack pnpm --filter @kontave/client-updates-contracts build && corepack pnpm --filter @kontave/client-updates-application build && corepack pnpm --filter @kontave/client-updates-electron build",
    "build": "corepack pnpm build:shared && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('Desktop contract checks run through TypeScript')\"",
    "dist:win": "corepack pnpm build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@kontave/auth-application": "workspace:*",
    "@kontave/auth-domain": "workspace:*",
    "@kontave/auth-supabase": "workspace:*",
    "@kontave/brand-assets": "workspace:*",
    "@kontave/client-feedback-application": "workspace:*",
    "@kontave/client-connectivity-application": "workspace:*",
    "@kontave/client-connectivity-contracts": "workspace:*",
    "@kontave/client-interaction-application": "workspace:*",
    "@kontave/client-updates-application": "workspace:*",
    "@kontave/client-updates-contracts": "workspace:*",
    "@kontave/client-updates-electron": "workspace:*",
    "@kontave/design-tokens": "workspace:*",
    "@kontave/device-contracts": "workspace:*",
    "@kontave/devices-core": "workspace:*",
    "@kontave/devices-node": "workspace:*",
    "@kontave/native-api-contracts": "workspace:*",
    "@kontave/modules-application": "workspace:*",
    "@kontave/modules-domain": "workspace:*",
    "@kontave/organization-delegations-domain": "workspace:*",
    "@kontave/organizations-domain": "workspace:*",
    "@kontave/ui-dom": "workspace:*",
    "@kontave/workspace-context-application": "workspace:*",
    "@supabase/supabase-js": "^2.99.1",
    "@fontsource/darker-grotesque": "^5.2.8",
    "lucide-react": "^1.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.kontave.desktop",
    "productName": "Kontave Desktop",
    "asar": true,
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      {
        "from": "../../packages/ui/brand-assets/src/kontave-icon.png",
        "to": "kontave-icon.png"
      }
    ],
    "directories": { "output": "release" },
    "win": {
      "target": ["nsis"],
      "icon": "../../packages/ui/brand-assets/src/kontave-icon.png",
      "artifactName": "Kontave-Desktop-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [{ "provider": "github", "owner": "jav1212", "repo": "kont", "releaseType": "release" }]
  }
}
