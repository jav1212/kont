{
  "name": "@kontave/desktop",
  "version": "0.1.0",
  "description": "Aplicación nativa de escritorio de la plataforma Kontave",
  "author": "Kontave",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:shared": "corepack pnpm --filter @kontave/devices build && corepack pnpm --filter @kontave/client-updates build",
    "build": "corepack pnpm build:shared && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "dist:win": "corepack pnpm build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource/darker-grotesque": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@kontave/access-control": "workspace:*",
    "@kontave/auth": "workspace:*",
    "@kontave/brand-assets": "workspace:*",
    "@kontave/client-connectivity": "workspace:*",
    "@kontave/client-feedback": "workspace:*",
    "@kontave/client-interaction": "workspace:*",
    "@kontave/client-remote": "workspace:*",
    "@kontave/client-runtime": "workspace:*",
    "@kontave/client-updates": "workspace:*",
    "@kontave/ui": "workspace:*",
    "@kontave/devices": "workspace:*",
    "@kontave/modules": "workspace:*",
    "@kontave/monetary": "workspace:*",
    "@kontave/client-contracts": "workspace:*",
    "@kontave/navigation": "workspace:*",
    "@kontave/operation-context": "workspace:*",
    "@kontave/delegated-access": "workspace:*",
    "@kontave/organizations": "workspace:*",
    "@kontave/settings": "workspace:*",
    "@kontave/workspace-context-application": "workspace:*",
    "@supabase/supabase-js": "^2.99.1",
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.9",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.7.0",
    "react": "19.2.3",
    "react-aria-components": "^1.12.0",
    "react-dom": "19.2.3",
    "serialport": "^13.0.0",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.kontave.desktop",
    "productName": "Kontave Desktop",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/ui/brand-assets/src/kontave-app-icon.png",
        "to": "kontave-app-icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../../packages/ui/brand-assets/src/kontave-app-icon.png",
      "artifactName": "Kontave-Desktop-Setup.${ext}"
    },
    "mac": {
      "icon": "../../packages/ui/brand-assets/src/kontave-app-icon.png",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jav1212",
        "repo": "kont",
        "releaseType": "release"
      }
    ]
  }
}
