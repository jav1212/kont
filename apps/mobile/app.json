{
  "expo": {
    "name": "Kontave",
    "slug": "kontave",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../../packages/ui/brand-assets/src/kontave-icon.png",
    "splash": {
      "image": "../../packages/ui/brand-assets/src/kontave-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D93A10"
    },
    "userInterfaceStyle": "automatic",
    "scheme": "kontave",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kontave.mobile"
    },
    "android": {
      "package": "com.kontave.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
